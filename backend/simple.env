# Copy this file to `.env` and fill in values.
# Azure Configuration
AZURE_STORAGE_CONNECTION_STRING=

# Server
# Server Configuration
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meta_academy_crm
DB_USER=postgres
DB_PASSWORD=postgres

# WhatsApp / Meta Webhook
# You define this string yourself, then paste the same value into Meta Webhooks verify token.
WHATSAPP_VERIFY_TOKEN=


# Optional: Access token (needed only if you later send messages via Graph API)
WHATSAPP_ACCESS_TOKEN=
