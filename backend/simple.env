# Copy this file to `.env` and fill in values.
# Azure Configuration
AZURE_STORAGE_CONNECTION_STRING=

# Server
# Server Configuration
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meta_academy_crm
DB_USER=postgres
DB_PASSWORD=postgres

# WhatsApp / Meta Webhook
# You define this string yourself, then paste the same value into Meta Webhooks verify token.
WHATSAPP_VERIFY_TOKEN=
# WhatsApp Cloud API
# Phone Number ID (used for sending messages). You can find it in WhatsApp Manager / API setup.
WHATSAPP_PHONE_NUMBER_ID=
# Optional: override Graph API version
WHATSAPP_API_VERSION=v20.0
# Optional: Access token (needed only if you later send messages via Graph API)
WHATSAPP_ACCESS_TOKEN=
